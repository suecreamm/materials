&CONTROL
  calculation='scf'
  prefix='pb',
  pseudo_dir = '~/Pb/pseudo/',
  outdir      = './tmp',
/
&SYSTEM
  ibrav=  2,
  ! Experimental lattice parameter, from Phys. Rev. 25, 753 (1925)
  celldm(1) = 9.297,
  nat= 1,
  ntyp= 1,
  ecutwfc = 30.0
  occupations='smearing',
  smearing='marzari-vanderbilt',
  degauss=0.05
/
&ELECTRONS
  conv_thr =  1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Pb 207.2 Pb.upf
ATOMIC_POSITIONS
  Pb 0.00 0.00 0.00
K_POINTS {automatic}
8 8 8 0 0 0
