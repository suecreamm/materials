&control
  calculation = 'bands',
  prefix      = 'pb',
  outdir      = './tmp',
  pseudo_dir  = '/home/hwang/Pb/pseudo/',
  verbosity   = 'high',
/

&system
  ibrav = 0,
  nat   = 1,
  ntyp  = 1,
  ecutwfc = 30.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss  = 0.05,
  nbnd = 10,
/

&electrons
  conv_thr = 1.0d-10,
  mixing_beta = 0.7,
/

