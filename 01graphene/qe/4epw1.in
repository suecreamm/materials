&inputepw
  ! ---- I/O ----
  prefix    = 'graphene'          ! = PW/PH prefix
  outdir    = './out'             ! = PW/PH outdir
  dvscf_dir='./out/_ph0'
  ! 튜토리얼도 dvscf_dir에 phonon 결과 폴더를 지정함:contentReference[oaicite:2]{index=2}

  ! ---- Core switches (tutorial-style) ----
  ep_coupling = .true.            ! e-ph coupling workflow on
  elph        = .true.            ! compute e-ph coefficients
  epwwrite    = .true.            ! write e-ph matrices in Wannier representation
  epwread     = .false.           ! first run: do NOT read epmatwp
  wannierize  = .true.            ! build Wannier functions (W90 library)

  etf_mem     = 0                 ! 0: less mem, more I/O (tutorial example)

  ! ---- Wannier subspace ----
  ! 그래핀 π-밴드(2개 원자 * pz)만 다룰거면 보통 2 Wannier로 시작 가능.
  nbndsub   = 8
  num_iter  = 300                 ! Wannier disentanglement iterations (tutorial)

  ! disentanglement window (예시값; 당신의 밴드구조/도핑에 맞춰 조정 필요)
  dis_froz_min = -3.0
  dis_froz_max =  3.0
  dis_win_min  = -12.0
  dis_win_max  =  12.0

  ! projections: graphene π manifold
  proj(1) = 'random'
  ! (원하면 sigma까지: 'C:sp2' 류로 확장하는데, 이건 pseudopot/버전에 따라 표현이 달라 "확실하지 않음")

  iverbosity = 2                  ! verbose SC output (tutorial)

  ! ---- Smearing windows for EPC ----
  fsthick  = 0.4                  ! [eV] (tutorial example)
  degaussw = 0.10                 ! [eV] (tutorial example)
  degaussq = 0.50                 ! [meV] (tutorial example)

  ! ---- Grids (IMPORTANT) ----
  ! coarse electronic grid (must be a FULL uniform mesh)
  nk1 = 12
  nk2 = 12
  nk3 = 1

  ! coarse phonon grid (coarse q-mesh; 예시로 6x6x1)
  nq1 = 6
  nq2 = 6
  nq3 = 1

  ! fine grids for interpolation (예시값; 실제론 더 키워야 수렴)
  mp_mesh_k = .true.              ! tutorial uses irreducible fine mesh
  nkf1 = 120
  nkf2 = 120
  nkf3 = 1

  nqf1 = 60
  nqf2 = 60
  nqf3 = 1

  ! ---- Outputs for EPC / superconductivity ----
  ephwrite  = .true.              ! write ephmatXX etc (tutorial)

  eliashberg = .true.             ! enables α2F(ω), λ(ω) outputs etc
  liso       = .true.             ! isotropic ME (tutorial has liso case for Pb)
  ! laniso   = .true.             ! (선택) anisotropic ME (FSR). 원하면 liso 대신 laniso 사용
  limag      = .true.
  lpade      = .true.
  lacon      = .false.            ! anisotropic에선 비싸서 off 권장(튜토리얼 설명)

  nsiter        = 500
  conv_thr_iaxis = 1.0d-3         ! tutorial value
  wscut         = 0.5             ! [eV] tutorial value

  muc    = 0.10                   ! μ* (graphene은 보통 더 클 수도/작을 수도 있는데, 이 값은 "가정"임)
  nstemp = 8
  temps  = 5 100                  ! 5K~100K 균등 분할 (tutorial)
/

